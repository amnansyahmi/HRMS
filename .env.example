# Production requires PostgreSQL. Local development uses persistent PGlite in .data/hrms.
DATABASE_URL=
# Canonical origin, required for a production deployment.
APP_URL=http://localhost:3000
# Local demonstration only; rejected on Vercel and production.
DEMO_MODE=true
# Server-only: use your current ai-nonymauz-cloud origin plus /v1.
AI_NONYMAUZ_BASE_URL=
AI_NONYMAUZ_API_KEY=
# Set to an alias listed by your backend's GET /v1/models.
AI_NONYMAUZ_MODEL=ai-nonymauz-fast
# Company owner must enable AI in Settings before any HR records are sent.
UPLOAD_MAX_BYTES=2097152
COMPANY_STORAGE_MAX_BYTES=104857600
