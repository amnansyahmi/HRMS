# Production requires PostgreSQL; local development uses .data/hrms PGlite.
DATABASE_URL=
APP_URL=http://localhost:3000
# Temporary one-click demo access is ON by default, including production.
# Each browser gets an isolated fabricated workspace. Set false for credential-only entry.
DEMO_MODE=true
DEMO_AI_ENABLED=false
# Server-only ai-nonymauz-cloud endpoint and an alias from GET /v1/models.
AI_NONYMAUZ_BASE_URL=
AI_NONYMAUZ_API_KEY=
AI_NONYMAUZ_MODEL=ai-nonymauz-fast
# Owner separately enables AI, individual assistants and confirmed action cards in Settings.
UPLOAD_MAX_BYTES=2097152
COMPANY_STORAGE_MAX_BYTES=104857600
# Email verification, password reset and employee invitations use this outbox provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_NOTIFICATIONS=false
# Random 32-byte hex keys. Keep both private and preserve the MFA key across restores.
AUTH_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
# External scheduler calls GET /api/cron with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Optional private transcription/OCR worker. Production URLs must use HTTPS.
MEDIA_WORKER_URL=
MEDIA_WORKER_API_KEY=
# Alternative local receipt OCR needs the installed Tesseract executable.
OCR_ENABLED=false
TESSERACT_PATH=tesseract
